# Unity .gitignore estándar profesional
# Creado para KAIROS: Sombras en Altamar

# Directorios generados por Unity (reconstruidos localmente)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Aa]ssetStoreTools*

# Archivos de cache y locks
/[Tt]emp/UnityLockfile
sysinfo.txt
crashlytics-build.properties

# Archivos de soluciones de IDEs generados automáticamente por Unity
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Builds compiladas y volcados
*.apk
*.aab
*.unitypackage
*.app
*.exe

# Sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# FBX de Mixamo con modelo crudo completo (se usan los clips extraídos en Clips/)
/Assets/Kairos/Models/Protagonista/Animaciones/
/Assets/Kairos/Models/Protagonista/Animaciones.meta

# Materiales locales de exposicion / guion (no subir a GitHub)
/docs/*.html

